# Démo graphique HIRES pour Oric Atmos (BASIC 1.1)
# Bandes de couleur, cercles concentriques, étoile de rayons, texte et son.
10 REM DEMO HIRES - ORICUTRON MAC/IOS
20 HIRES:PAPER 0:INK 7
30 FOR B=0 TO 6:CURSET 6,B*28,0:FILL 28,1,B+1:NEXT
40 ZAP
50 FOR R=10 TO 90 STEP 10:CURSET 120,100,0:CIRCLE R,1:NEXT
60 FOR A=0 TO 2*PI STEP PI/12
70 CURSET 120,100,0:DRAW INT(95*COS(A)),INT(95*SIN(A)),1
80 NEXT
90 CLS:PRINT"  ORICUTRON 1.2 - MAC / IPHONE / IPAD"
100 PRINT"  DEMO HIRES EN BASIC - UNE TOUCHE...";
110 PING
120 GET K$:TEXT:CLS:PRINT"AU REVOIR !"
